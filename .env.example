# Google Cloud
GCP_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=meeting-transcripts-bucket

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Google Workspace (OAuth or Service Account)
