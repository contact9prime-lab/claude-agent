# --- LLM Provider ---
# Provider: gemini, openai, or ollama
LLM_PROVIDER=gemini

# API key (also reads GEMINI_API_KEY for backwards compatibility)
LLM_API_KEY=
GEMINI_API_KEY=

# Model name (default depends on provider)
# LLM_MODEL=gemini-2.5-flash
# LLM_MODEL=gpt-4o-audio-preview
# LLM_MODEL=llama3

# Base URL (required for ollama, optional for openai-compatible APIs)
# LLM_BASE_URL=http://localhost:11434/v1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Override default storage paths (optional)
# DB_PATH=~/.deskvoice/deskvoice.db
# AUDIO_DIR=~/.deskvoice/audio

# --- Telegram Bot ---
# Get from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs (leave empty for no restrictions)
# TELEGRAM_ALLOWED_USERS=
# For webhook mode (optional — defaults to long polling)
# TELEGRAM_WEBHOOK_URL=https://your-server.com/telegram

# --- WhatsApp (Meta Cloud API) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=deskvoice-verify
# WHATSAPP_APP_SECRET=

# --- WhatsApp (Twilio — alternative) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# --- Slack ---
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...    (for Socket Mode)
# SLACK_SIGNING_SECRET=
