# --- LLM Provider ---
# Provider: gemini, openai, or ollama
LLM_PROVIDER=gemini

# API key (also reads GEMINI_API_KEY for backwards compatibility)
LLM_API_KEY=
GEMINI_API_KEY=

# Model name (default depends on provider)
# LLM_MODEL=gemini-3-flash
# LLM_MODEL=gpt-4o-audio-preview
# LLM_MODEL=llama3

# Base URL (required for ollama, optional for openai-compatible APIs)
# LLM_BASE_URL=http://localhost:11434/v1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Override default storage paths (optional)
# DB_PATH=~/.deskvoice/deskvoice.db
# AUDIO_DIR=~/.deskvoice/audio
